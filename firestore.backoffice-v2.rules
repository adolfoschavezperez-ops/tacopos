rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function authUserDoc(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)/authUsers/$(request.auth.uid));
    }

    function isAuthorizedInRestaurant(restaurantId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)/authUsers/$(request.auth.uid)) &&
        authUserDoc(restaurantId).data.active == true;
    }

    function isSuperAdmin(restaurantId) {
      return isAuthorizedInRestaurant(restaurantId) &&
        authUserDoc(restaurantId).data.isSuperAdmin == true;
    }

    function hasPermission(restaurantId, permission) {
      return isAuthorizedInRestaurant(restaurantId) &&
        (isSuperAdmin(restaurantId) ||
          authUserDoc(restaurantId).data.permissions[permission] == true);
    }

    function canAccessBranch(restaurantId, branchId) {
      return isAuthorizedInRestaurant(restaurantId) &&
        (isSuperAdmin(restaurantId) ||
          !('branchAccess' in authUserDoc(restaurantId).data) ||
          authUserDoc(restaurantId).data.branchAccess.size() == 0 ||
          branchId in authUserDoc(restaurantId).data.branchAccess);
    }

    function canReadCash(restaurantId) {
      return hasPermission(restaurantId, 'canManageCash') ||
        hasPermission(restaurantId, 'canAuthorizeCashWithdrawals') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canReadAuthorizations(restaurantId) {
      return hasPermission(restaurantId, 'canAuthorizeCashWithdrawals') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canReadInventory(restaurantId) {
      return hasPermission(restaurantId, 'canManageKitchenStock') ||
        hasPermission(restaurantId, 'canViewKitchenReports') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canReadPurchases(restaurantId) {
      let u = authUserDoc(restaurantId).data;
      return isAuthorizedInRestaurant(restaurantId) && (
        u.isSuperAdmin == true ||
        u.permissions.canViewAdmin == true ||
        u.permissions.canViewPurchases == true ||
        u.permissions.canViewAccountsPayable == true ||
        u.permissions.canViewPurchaseReports == true ||
        u.permissions.canManageSuppliers == true ||
        u.permissions.canRegisterPurchases == true ||
        u.permissions.canPaySuppliers == true
      );
    }

    function canManageSuppliersCatalog(restaurantId) {
      return hasPermission(restaurantId, 'canManageSuppliers') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canCreatePurchase(restaurantId) {
      return hasPermission(restaurantId, 'canRegisterPurchases') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canPaySupplierBalance(restaurantId) {
      return hasPermission(restaurantId, 'canPaySuppliers') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canCancelSupplierOps(restaurantId) {
      return hasPermission(restaurantId, 'canCancelSupplierPayments') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canUpdateSupplierPurchase(restaurantId) {
      let u = authUserDoc(restaurantId).data;
      return isAuthorizedInRestaurant(restaurantId) && (
        u.isSuperAdmin == true ||
        u.permissions.canViewAdmin == true ||
        u.permissions.canRegisterPurchases == true ||
        u.permissions.canPaySuppliers == true ||
        u.permissions.canCancelSupplierPayments == true
      );
    }

    function canAuthorizeOps(restaurantId) {
      return hasPermission(restaurantId, 'canAuthorizeCashWithdrawals') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canManageKitchenOps(restaurantId) {
      return hasPermission(restaurantId, 'canManageKitchenStock') ||
        hasPermission(restaurantId, 'canOpenKitchen') ||
        hasPermission(restaurantId, 'canCloseKitchen') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canReadFinance(restaurantId) {
      return canReadPurchases(restaurantId) ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canManagePartnersOps(restaurantId) {
      return hasPermission(restaurantId, 'canManageSuppliers') ||
        hasPermission(restaurantId, 'canViewPurchases') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    function canManageCashAdmin(restaurantId) {
      return hasPermission(restaurantId, 'canManageCash') ||
        hasPermission(restaurantId, 'canViewAdmin');
    }

    match /restaurants/{restaurantId} {
      allow read: if isAuthorizedInRestaurant(restaurantId);
      allow write: if false;

      match /authUsers/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      match /branches/{branchId} {
        allow read: if isAuthorizedInRestaurant(restaurantId) &&
          canAccessBranch(restaurantId, branchId);
        allow write: if isSuperAdmin(restaurantId);
      }

      match /orders/{orderId} {
        allow read: if (hasPermission(restaurantId, 'canViewAdmin') || canReadFinance(restaurantId)) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create, delete: if false;
        allow update: if (hasPermission(restaurantId, 'canCancelOrders') ||
            hasPermission(restaurantId, 'canCancelPayments') ||
            hasPermission(restaurantId, 'canViewAdmin')) &&
          canAccessBranch(restaurantId, resource.data.branchId);

        match /items/{itemId} {
          allow read: if (hasPermission(restaurantId, 'canViewAdmin') || canReadFinance(restaurantId)) &&
            canAccessBranch(
              restaurantId,
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId)).data.branchId
            );
          allow create, delete: if false;
          allow update: if (hasPermission(restaurantId, 'canCancelOrders') ||
              hasPermission(restaurantId, 'canViewAdmin')) &&
            canAccessBranch(
              restaurantId,
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId)).data.branchId
            );
        }

        match /payments/{paymentId} {
          allow read: if (hasPermission(restaurantId, 'canViewAdmin') || canReadFinance(restaurantId)) &&
            canAccessBranch(
              restaurantId,
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId)).data.branchId
            );
          allow create, delete: if false;
          allow update: if (hasPermission(restaurantId, 'canCancelPayments') ||
              hasPermission(restaurantId, 'canViewAdmin')) &&
            canAccessBranch(
              restaurantId,
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/orders/$(orderId)).data.branchId
            );
        }
      }

      match /cashSessions/{sessionId} {
        allow read: if (canReadCash(restaurantId) || canReadFinance(restaurantId)) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create, delete: if false;
        allow update: if canManageCashAdmin(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId) &&
          resource.data.status == 'closed' &&
          request.resource.data.status == 'closed';
      }

      match /cashWithdrawalRequests/{requestId} {
        allow read: if (canReadCash(restaurantId) || canReadFinance(restaurantId)) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create: if canManageCashAdmin(restaurantId) &&
          canAccessBranch(restaurantId, request.resource.data.branchId) &&
          request.resource.data.isHistorical == true &&
          request.resource.data.restaurantId == restaurantId;
        allow update: if canAuthorizeOps(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId) &&
          resource.data.status == 'pending';
        allow delete: if false;
      }

      match /discountAuthorizationRequests/{requestId} {
        allow read: if canReadAuthorizations(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create, delete: if false;
        allow update: if canAuthorizeOps(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId) &&
          resource.data.status == 'pending';
      }

      match /kitchenSessions/{sessionId} {
        allow read: if (canReadInventory(restaurantId) || canReadFinance(restaurantId)) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create: if canManageKitchenOps(restaurantId) &&
          canAccessBranch(restaurantId, request.resource.data.branchId);
        allow update: if canManageKitchenOps(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow delete: if false;

        match /items/{itemId} {
          allow read: if (canReadInventory(restaurantId) || canReadFinance(restaurantId)) &&
            canAccessBranch(
              restaurantId,
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/kitchenSessions/$(sessionId)).data.branchId
            );
          allow create, update: if canManageKitchenOps(restaurantId) &&
            canAccessBranch(
              restaurantId,
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/kitchenSessions/$(sessionId)).data.branchId
            );
          allow delete: if false;
        }
      }

      match /kitchenStockItems/{itemId} {
        allow read: if canReadInventory(restaurantId) || canReadFinance(restaurantId);
        allow create, update: if canManageKitchenOps(restaurantId);
        allow delete: if false;
      }

      match /ingredientYieldProfiles/{profileId} {
        allow read: if canReadInventory(restaurantId) || canReadFinance(restaurantId);
        allow create, update: if canManageKitchenOps(restaurantId);
        allow delete: if false;
      }

      match /productRecipes/{recipeId} {
        allow read: if canReadInventory(restaurantId) || canReadFinance(restaurantId);
        allow create, update: if canManageKitchenOps(restaurantId);
        allow delete: if false;
      }

      match /theoreticalProductRecipes/{recipeId} {
        allow read: if canReadInventory(restaurantId) || canReadFinance(restaurantId);
        allow create, update: if canManageKitchenOps(restaurantId);
        allow delete: if false;
      }

      match /productStockOuts/{stockOutId} {
        allow read: if canReadInventory(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create: if canManageKitchenOps(restaurantId) &&
          canAccessBranch(restaurantId, request.resource.data.branchId);
        allow update: if canManageKitchenOps(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow delete: if false;
      }

      match /activityLog/{logId} {
        allow read: if isAuthorizedInRestaurant(restaurantId);
        allow create: if isAuthorizedInRestaurant(restaurantId);
        allow update, delete: if false;
      }

      match /products/{productId} {
        allow read: if isAuthorizedInRestaurant(restaurantId);
        allow write: if false;
      }

      match /suppliers/{supplierId} {
        allow read: if canReadPurchases(restaurantId);
        allow create, update: if canManageSuppliersCatalog(restaurantId);
        allow delete: if false;
      }

      match /purchaseItems/{itemId} {
        allow read: if canReadPurchases(restaurantId);
        allow create, update: if canManageSuppliersCatalog(restaurantId);
        allow delete: if false;
      }

      match /supplierPurchases/{purchaseId} {
        allow read: if canReadPurchases(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create: if canCreatePurchase(restaurantId) &&
          canAccessBranch(restaurantId, request.resource.data.branchId);
        allow update: if canUpdateSupplierPurchase(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow delete: if false;

        match /items/{itemId} {
          allow read: if canReadPurchases(restaurantId) &&
            canAccessBranch(
              restaurantId,
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/supplierPurchases/$(purchaseId)).data.branchId
            );
          allow create, update: if canCreatePurchase(restaurantId) &&
            canAccessBranch(
              restaurantId,
              get(/databases/$(database)/documents/restaurants/$(restaurantId)/supplierPurchases/$(purchaseId)).data.branchId
            );
          allow delete: if false;
        }
      }

      match /supplierPayments/{paymentId} {
        allow read: if canReadPurchases(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create: if canPaySupplierBalance(restaurantId) &&
          canAccessBranch(restaurantId, request.resource.data.branchId);
        allow update: if canCancelSupplierOps(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId) &&
          resource.data.status == 'active';
        allow delete: if false;
      }

      match /partners/{partnerId} {
        allow read: if canReadFinance(restaurantId);
        allow create, update: if canManagePartnersOps(restaurantId);
        allow delete: if false;
      }

      match /partnerContributions/{contributionId} {
        allow read: if canReadFinance(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create: if (canPaySupplierBalance(restaurantId) ||
            canManagePartnersOps(restaurantId)) &&
          canAccessBranch(restaurantId, request.resource.data.branchId);
        allow update: if canCancelSupplierOps(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId) &&
          resource.data.status == 'active';
        allow delete: if false;
      }

      match /expensePolicies/{policyId} {
        allow read: if canReadFinance(restaurantId) || canReadAuthorizations(restaurantId);
        allow create, update: if canAuthorizeOps(restaurantId);
        allow delete: if false;
      }

      match /expensePolicyUsage/{usageId} {
        allow read: if canReadFinance(restaurantId) || canReadAuthorizations(restaurantId);
        allow write: if false;
      }

      match /settings/{settingId} {
        allow read: if canReadFinance(restaurantId) || canReadAuthorizations(restaurantId);
        allow create, update: if settingId == 'expensePolicies' && canAuthorizeOps(restaurantId);
        allow delete: if false;
      }

      match /backofficePurchaseTargets/{docId} {
        allow read: if (canReadFinance(restaurantId) || canReadPurchases(restaurantId)) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create, update: if canManageSuppliersCatalog(restaurantId) &&
          canAccessBranch(restaurantId, request.resource.data.branchId) &&
          request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      match /backofficePurchaseBudgets/{docId} {
        allow read: if (canReadFinance(restaurantId) || canReadPurchases(restaurantId)) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create, update: if canManageSuppliersCatalog(restaurantId) &&
          canAccessBranch(restaurantId, request.resource.data.branchId) &&
          request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      match /backofficeFinanceBudgets/{docId} {
        allow read: if canReadFinance(restaurantId) &&
          canAccessBranch(restaurantId, resource.data.branchId);
        allow create, update: if canManageSuppliersCatalog(restaurantId) &&
          canAccessBranch(restaurantId, request.resource.data.branchId) &&
          request.resource.data.restaurantId == restaurantId;
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
